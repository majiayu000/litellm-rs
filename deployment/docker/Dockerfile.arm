# ARM-specific Dockerfile with enhanced dependencies
FROM rust:1.96.1-bookworm AS builder
ARG RELEASE_FEATURES="postgres,sqlite,redis,s3,metrics,tracing,websockets,providers-extra,providers-extended,mcp-validation,a2a"

# Install comprehensive system dependencies for ARM cross-compilation
RUN apt-get update && apt-get install -y \
    # Basic build tools
    pkg-config \
    build-essential \
    cmake \
    git \
    ca-certificates \
    # SSL/TLS support
    libssl-dev \
    # PostgreSQL support
    libpq-dev \
    # Compilation tools
    clang \
    llvm \
    # Cross-compilation tools for ARM
    gcc-arm-linux-gnueabihf \
    libc6-dev-armhf-cross \
    # Additional tools
    musl-tools \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for AWS LC and cross-compilation
ENV CMAKE=cmake
ENV CC=clang
ENV CXX=clang++
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc
ENV PKG_CONFIG_ALLOW_CROSS=1

# Add Rust targets for cross-compilation
RUN rustup target add armv7-unknown-linux-gnueabihf

# Create app user
RUN useradd -m -u 1001 appuser

# Set working directory
WORKDIR /app

# Copy dependency files and build configuration
COPY Cargo.toml Cargo.lock build.rs ./

# Cargo validates all declared target paths, including examples and benches.
COPY src ./src
COPY examples ./examples
COPY benches ./benches
COPY config ./config
COPY docs/openapi/admin.json docs/openapi/inference.json ./docs/openapi/

# Build the gateway with the same feature profile as release archives.
RUN cargo build --release --locked --no-default-features --features "$RELEASE_FEATURES" --bin gateway

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1001 appuser

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /app/target/release/gateway /usr/local/bin/gateway

# Copy configuration files
COPY --from=builder /app/config ./config

# Create data directory
RUN mkdir -p /app/data && chown -R appuser:appuser /app

# Switch to app user
USER appuser

# Expose ports
EXPOSE 8000 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command
CMD ["gateway", "--config", "config/gateway.yaml"]

# Labels
LABEL org.opencontainers.image.title="LiteLLM-RS"
LABEL org.opencontainers.image.description="A high-performance AI Gateway written in Rust (ARM Build)"
LABEL org.opencontainers.image.authors="LiteLLM-RS Contributors"
LABEL org.opencontainers.image.url="https://github.com/majiayu000/litellm-rs"
LABEL org.opencontainers.image.source="https://github.com/majiayu000/litellm-rs"
LABEL org.opencontainers.image.licenses="MIT"
